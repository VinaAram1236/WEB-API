# Server protection key for /api/generate-quiz
# For local development, use LOCAL_DEV_KEY
WEB_API_KEY=LOCAL_DEV_KEY

# Default AI provider: gemini, openai, or anthropic
AI_PROVIDER=openai

# Provider API keys
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=sk-your_real_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional provider model overrides
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3.5
